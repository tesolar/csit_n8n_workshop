      "parameters": {
        "jsCode": "const answer = $input.all().map((j)=>j.json);\nconst expected = [\n  {\n    \"average_salary\": 43533.333333333336,\n    \"average_premium\": 1666.6666666666667\n  }\n];\n\n\nconst idsB = new Set(answer.map(item => item.id));\nconst matches = expected.filter(item => idsB.has(item.id));\n\nconst corrected = matches.length == expected.length;\nreturn [{corrected:corrected}];\n"
      },
