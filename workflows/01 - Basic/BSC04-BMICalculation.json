        "jsCode": "return [\n  {\n    \"user_id\": \"U001\",\n    \"age\": 24,\n    \"height\": 168,\n    \"weight\": 60,\n    \"salary\": 22000,\n    \"premium\": null\n  },\n  {\n    \"user_id\": \"U002\",\n    \"age\": 29,\n    \"height\": 172,\n    \"weight\": 70,\n    \"salary\": 32000,\n    \"premium\": 1800\n  },\n  {\n    \"user_id\": \"U003\",\n    \"age\": 35,\n    \"height\": 165,\n    \"weight\": 68,\n    \"salary\": 45000,\n    \"premium\": 2500\n  },\n  {\n    \"user_id\": \"U004\",\n    \"age\": 41,\n    \"height\": 170,\n    \"weight\": 75,\n    \"salary\": 52000,\n    \"premium\": null\n  },\n  {\n    \"user_id\": \"U005\",\n    \"age\": 33,\n    \"height\": 160,\n    \"weight\": 55,\n    \"salary\": 38000,\n    \"premium\": 2100\n  },\n  {\n    \"user_id\": \"U006\",\n    \"age\": 27,\n    \"height\": 175,\n    \"weight\": 72,\n    \"salary\": 29000,\n    \"premium\": 1600\n  },\n  {\n    \"user_id\": \"U007\",\n    \"age\": 46,\n    \"height\": 168,\n    \"weight\": 78,\n    \"salary\": 60000,\n    \"premium\": 3200\n  },\n  {\n    \"user_id\": \"U008\",\n    \"age\": 52,\n    \"height\": 162,\n    \"weight\": 70,\n    \"salary\": 72000,\n    \"premium\": null\n  },\n  {\n    \"user_id\": \"U009\",\n    \"age\": 31,\n    \"height\": 180,\n    \"weight\": 85,\n    \"salary\": 41000,\n    \"premium\": 2300\n  },\n  {\n    \"user_id\": \"U010\",\n    \"age\": 22,\n    \"height\": 158,\n    \"weight\": 50,\n    \"salary\": 18000,\n    \"premium\": null\n  },\n  {\n    \"user_id\": \"U011\",\n    \"age\": 38,\n    \"height\": 173,\n    \"weight\": 74,\n    \"salary\": 48000,\n    \"premium\": 2600\n  },\n  {\n    \"user_id\": \"U012\",\n    \"age\": 44,\n    \"height\": 169,\n    \"weight\": 69,\n    \"salary\": 55000,\n    \"premium\": 3000\n  },\n  {\n    \"user_id\": \"U013\",\n    \"age\": 28,\n    \"height\": 166,\n    \"weight\": 63,\n    \"salary\": 31000,\n    \"premium\": null\n  },\n  {\n    \"user_id\": \"U014\",\n    \"age\": 50,\n    \"hei