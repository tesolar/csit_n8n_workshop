\": \"U014\",\n    \"age\": 50,\n    \"height\": 171,\n    \"weight\": 80,\n    \"salary\": 68000,\n    \"premium\": 3500\n  },\n  {\n    \"user_id\": \"U015\",\n    \"age\": 34,\n    \"height\": 164,\n    \"weight\": 67,\n    \"salary\": 42000,\n    \"premium\": 2400\n  }\n];\n\n\nconst idsB = new Set(answer.map(item => item.id));\nconst matches = expected.filter(item => idsB.has(item.id));\n\nconst corrected = matches.length == expected.length;\nreturn [{corrected:corrected}];\n"
