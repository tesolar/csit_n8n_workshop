                                         "jsCode":  "/*\n * Candid GRC Co., Ltd.\n * Copyright Â© 2026 Candid GRC Co., Ltd.\n * All Rights Reserved.\n *\n * This source code is proprietary and confidential.\n * Unauthorized copying, modification, redistribution,\n * reverse engineering, or commercial use is strictly prohibited.\n *\n * This code forms part of the Candid GRC Automation Framework.\n */\n\nconst now = new Date();\nconst body = $json.body || {};\nconst prompt =\n  body.prompt ||\n  body.message ||\n  $json.prompt ||\n  $json.message ||\n  $input.first().json.chatInput ||\n  \"\";\n\nif (!String(prompt).trim()) {\n  throw new Error(\"Missing prompt/message in request body\");\n}\n\nconst sessionId = body.sessionId || body.session_id || \"session-\" + Date.now();\nconst userId = body.userId || body.user_id || \"anonymous\";\nconst requestId = body.requestId || \"req-\" + Date.now();\n\nreturn [\n  {\n    json: {\n      requestId: String(requestId),\n      sessionId: String(sessionId),\n      userId: String(userId),\n      model: body.model || \"models/gemini-2.5-flash\",\n      chatInput: String(prompt),\n      startTs: now.getTime(),\n      timestamp: now.toISOString(),\n      source: \"chat\",\n    },\n  },\n];\n"
                                     },
