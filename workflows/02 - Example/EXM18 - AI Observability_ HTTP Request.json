                      "parameters":  {
                                         "jsCode":  "/*\n * Candid GRC Co., Ltd.\n * Copyright © 2026 Candid GRC Co., Ltd.\n * All Rights Reserved.\n *\n * This source code is proprietary and confidential.\n * Unauthorized copying, modification, redistribution,\n * reverse engineering, or commercial use is strictly prohibited.\n *\n * This code forms part of the Candid GRC Automation Framework.\n */\n\nconst req = $(\"Prepare Input + Start Timer\").first().json;\nconst out = $input.first().json || {};\n\n// -- Helper: extract token usage from any node output -------------------------\nfunction safeNodeJsonItems(nodeName) {\n  try {\n    return $(nodeName).all().map((item) =\u003e item.json || {});\n  } catch (e) { return []; }\n}\n\nconst modelItems = safeNodeJsonItems(\"Gemini 2.5 Flash\");\n\nfunction findUsage(obj, depth = 0) {\n  if (!obj || typeof obj !== \"object\" || depth \u003e 5) return null;\n  const candidates = [\n    obj.tokenUsage, obj.usageMetadata, obj.usage,\n    obj.response?.usageMetadata, obj.response_metadata?.usage,\n    obj.metadata?.usageMetadata, obj.metadata?.tokenUsage,\n    obj.additional_kwargs?.usage, obj.additional_kwargs?.usageMetadata,\n    obj.data?.usageMetadata, obj.data?.usage,\n  ].filter(Boolean);\n  for (const c of candidates) { if (typeof c === \"object\") return c; }\n  for (const value of Object.values(obj)) {\n    if (value \u0026\u0026 typeof value === \"object\") {\n      const found = findUsage(value, depth + 1);\n      if (found) return found;\n    }\n  }\n  return null;\n}\n\nfunction firstUsageFromItems(items) {\n  for (let i = items.length - 1; i \u003e= 0; i--) {\n    const found = findUsage(items[i]);\n    if (found) return found;\n  }\n  return null;\n}\n\nfunction toNum(v, d = 0) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : d;\n}\n\n// Token usage: prefer chat-model node, fallback to HTTP response usageMetadata\nconst usageFromChatModel = firstUsageFromItems(modelItems) || {};\nconst usageFromHttp = findUsage(out) || {};\nconst usage = Object.keys(usageFromChatModel).length ? usageFromChatModel : usageFromHttp;\n\nconst inputTokens = toNum(\n  usage.promptTokens ?? usage.promptTokenCount ?? usage.inputTokens ??\n  usage.prompt_tokens ?? usage.input_tokens, 0);\nconst outputTokens = toNum(\n  usage.completionTokens ?? usage.candidatesTokenCount ?? usage.outputTokens ??\n  usage.completion_tokens ?? usage.output_tokens, 0);\nconst totalTokens = toNum(\n  usage.totalTokens ?? usage.totalTokenCount ?? usage.total_tokens ?? usage.totalToken,\n  inputTokens + outputTokens);\n\nlet tokenSource = \"not-available\";\nif (Object.keys(usageFromChatModel).length) tokenSource = \"chat-model-node\";\nelse if (Object.keys(usageFromHttp).length) tokenSource = \"http-response-metadata\";\n\n// -- Extract + parse structured JSON from Gemini -------------------------------\nfunction extractGeminiText(payload) {\n  const cands = Array.isArray(payload?.candidates) ? payload.candidates : [];\n  for (const candidate of cands) {\n    const parts = Array.isArray(candidate?.content?.parts) ? candidate.content.parts : [];\n    const text = parts.map((p) =\u003e (typeof p?.text === \"string\" ? p.text : \"\")).join(\"\\n\").trim();\n    if (text) return text;\n  }\n  return \"\";\n}\n\nconst rawGeminiText = extractGeminiText(out);\nlet parsed = {};\nif (rawGeminiText) {\n  try {\n    parsed = JSON.parse(rawGeminiText);\n  } catch (e) {\n    // Gemini returned plain text (non-JSON fallback)\n    parsed = { answer: rawGeminiText };\n  }\n}\n\n// -- Observability fields from parsed structured response ----------------------\nconst responseText = String(parsed.answer || rawGeminiText || \"\");\nconst intent = String(parsed.intent || \"\");\nconst confidence = toNum(parsed.confidence, 0);\nconst assumptions = JSON.stringify(Array.isArray(parsed.assumptions) ? parsed.assumptions : []);\nconst evidence = JSON.stringify(Array.isArray(parsed.evidence) ? parsed.evidence : []);\nconst uncertainty = String(parsed.uncertainty || \"\");\nconst limitations = JSON.stringify(Array.isArray(parsed.limitations) ? parsed.limitations : []);\n\nconst claims = Array.isArray(parsed.factual_claims) ? parsed.factual_claims : [];\nconst unsupportedClaims = claims.filter((c) =\u003e {\n  const status = String(c?.support_status || \"\").toLowerCase();\n  return status === \"unsupported\" || status === \"unknown\";\n}).length;\nconst hallucinationRate =\n  claims.length \u003e 0 ? Number((unsupportedClaims / claims.length).toFixed(4)) : null;\n\nconst biasRisk = String(parsed.bias_risk || \"unknown\").toLowerCase();\nconst hallucinationRisk = String(parsed.hallucination_risk || \"unknown\").toLowerCase();\nconst safetyRisk = String(parsed.safety_risk || \"unknown\").toLowerCase();\n\nconst autoNeedsReview =\n  (hallucinationRate !== null \u0026\u0026 hallucinationRate \u003e 0.2) ||\n  biasRisk === \"high\" || hallucinationRisk === \"high\";\nconst needsReview = Boolean(parsed.needs_review) || autoNeedsReview;\nconst reviewReason =\n  parsed.review_reason || (autoNeedsReview ? \"auto-threshold-triggered\" : \"\");\n\nconst latencyMs = Date.now() - Number(req.startTs || Date.now());\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      execution_id: $execution.id,\n      workflow_id: $workflow.id,\n      request_id: req.requestId,\n      user_id: req.userId,\n      session_id: req.sessionId,\n      model: req.model,\n      prompt: req.chatInput,\n      response: responseText,\n      intent,\n      confidence,\n      assumptions,\n      evidence,\n      uncertainty,\n      limitations,\n      factual_claim_count: claims.length,\n      unsupported_claim_count: unsupportedClaims,\n      hallucination_rate: hallucinationRate,\n      hallucination_risk: hallucinationRisk,\n      bias_risk: biasRisk,\n      safety_risk: safetyRisk,\n      needs_review: needsReview,\n      latency_ms: latencyMs,\n      input_tokens: inputTokens,\n      output_tokens: outputTokens,\n      total_tokens: totalTokens,\n      status: \"success\",\n      token_source: tokenSource,\n      review_reason: reviewReason,\n    },\n  },\n];"
                                     },
