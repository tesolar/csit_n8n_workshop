    {
      "parameters": {
        "method": "POST",
        "url": "http://browserless:3000/scrape",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"gotoOptions\": {\n    \"waitUntil\": \"networkidle0\",\n    \"timeout\": 60000\n  },\n  \"elements\": [\n    {\"selector\": \"title\"},\n    {\"selector\": \"h1\"},\n    {\"selector\": \"h2\"},\n    {\"selector\": \"p\"}\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3584,
        -416
      ],
      "id": "9a1d2c44-6208-415c-8f5c-5924a1997d4e",
      "name": "Web Scraping"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Extract the scraped data and organize it nicely\n * Makes it easy to understand what was found\n */\n\n// Create empty result structure\nconst result = {\n  url: $('When clicking ‘Execute workflow’').first().json.url,\n  title: null,\n  h1_headings: [],\n  h2_headings: [],\n  paragraphs: [],\n};\n\n// Loop through each selector's results\nconst data = $json.data || \"\";\n\nfor (const item of data) {\n  const selector = item.selector;\n  const results = item.results || [];\n\n  // Extract title\n  if (selector === \"title\" && results.length > 0) {\n    result.title = (results[0].text || \"\").trim();\n  }\n\n  // Extract H1 headings\n  else if (selector === \"h1\") {\n    result.h1_headings = results\n      .map((r) => (r.text || \"\").trim())\n      .filter((text) => text.length > 0);\n  }\n\n  // Extract H2 headings\n  else if (selector === \"h2\") {\n    result.h2_headings = results\n      .map((r) => (r.text || \"\").trim())\n      .filter((text) => text.length > 0);\n  }\n\n  // Extract paragraphs (limit to first 10)\n  else if (selector === \"p\") {\n    result.paragraphs = results\n      .map((r) => (r.text || \"\").trim())\n      .filter((text) => text.length > 0)\n      .slice(0, 10); // Only keep first 10 paragraphs\n  }\n}\n\nreturn result;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
