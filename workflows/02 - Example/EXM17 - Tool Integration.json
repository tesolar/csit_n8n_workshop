    {
      "parameters": {
        "functionCode": "// items[0].json.results มาจาก SearXNG\nconst results = items[0].json.results;\n\nreturn results.map((r) => {\n  const url = r.url || \"\";\n\n  const title = r.title || \"\";\n\n  const content = r.content || \"\";\n\n  const isPdf =\n    url.endsWith(\".pdf\") || url.includes(\"/pdf\") || url.includes(\"/download\");\n\n  return {\n    json: {\n      url,\n      type: isPdf ? \"pdf\" : \"url\",\n      title,\n      content,\n    },\n  };\n});\n\n\n\n\n"
      },
