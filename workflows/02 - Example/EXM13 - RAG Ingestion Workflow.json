    {
      "parameters": {
        "jsCode": "/*\n * Candid GRC Co., Ltd.\n * Copyright © 2026 Candid GRC Co., Ltd.\n * All Rights Reserved.\n *\n * This source code is proprietary and confidential.\n * Unauthorized copying, modification, redistribution,\n * reverse engineering, or commercial use is strictly prohibited.\n *\n * This code forms part of the Candid GRC Automation Framework.\n */\n\n// Split text into ~1000 character chunks with overlap\nconst fullText = $(\"Merge Paths\").first().json.fullText;\n// Use items[0].json.id because input comes from Postgres node which returns an array\nconst documentId = items[0] ? items[0].json.id : 0;\n\nif (!fullText || fullText.length === 0) {\n  throw new Error(\n    \"No text content available to chunk. Please check the Extraction steps.\",\n  );\n}\n\nconst CHUNK_SIZE = 1000;\nconst OVERLAP = 100;\nconst chunks = [];\n\nfor (let i = 0; i < fullText.length; i += CHUNK_SIZE - OVERLAP) {\n  const chunk = fullText.substring(i, i + CHUNK_SIZE).trim();\n  if (chunk.length > 50) {\n    chunks.push({\n      json: {\n        content: chunk,\n        chunk_index: chunks.length,\n        document_id: documentId,\n      },\n    });\n  }\n}\n\nreturn chunks;\n"
      },
