    {
      "parameters": {
        "jsCode": "/*\n * Candid GRC Co., Ltd.\n * Copyright © 2026 Candid GRC Co., Ltd.\n * All Rights Reserved.\n *\n * This source code is proprietary and confidential.\n * Unauthorized copying, modification, redistribution,\n * reverse engineering, or commercial use is strictly prohibited.\n *\n * This code forms part of the Candid GRC Automation Framework.\n */\n\n// Extract text from Browserless /content response (already plain text)\nlet fullText = \"\";\nconst data = items[0].json;\n\nif (typeof data === \"string\") {\n  fullText = data;\n} else if (data.data) {\n  fullText = data.data;\n} else {\n  fullText = JSON.stringify(data);\n}\n\n// Clean up HTML tags if any remain\nfullText = fullText\n  .replace(/<[^>]*>/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nconst url = $(\"Detect Content Type\").item.json.url;\nreturn [{ json: { fullText, url } }];\n"
