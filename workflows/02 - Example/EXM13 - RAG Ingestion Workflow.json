    },
    {
      "parameters": {
        "jsCode": "/*\n * Candid GRC Co., Ltd.\n * Copyright © 2026 Candid GRC Co., Ltd.\n * All Rights Reserved.\n *\n * This source code is proprietary and confidential.\n * Unauthorized copying, modification, redistribution,\n * reverse engineering, or commercial use is strictly prohibited.\n *\n * This code forms part of the Candid GRC Automation Framework.\n */\n\n// Read all incoming items from Parse PDF (Unstructured).\nconst inputItems = $input.all();\nconst textChunks = [];\n\nfor (const item of inputItems) {\n  const payload = item.json || {};\n\n  // Most common Unstructured shape after n8n item-splitting: { text: \"...\" }\n  if (typeof payload.text === \"string\" && payload.text.trim()) {\n    textChunks.push(payload.text.trim());\n    continue;\n  }\n\n  // Some setups return nested arrays/objects.\n  if (Array.isArray(payload.elements)) {\n    for (const el of payload.elements) {\n      if (typeof el?.text === \"string\" && el.text.trim()) {\n        textChunks.push(el.text.trim());\n      }\n    }\n    continue;\n  }\n\n  if (Array.isArray(payload.data)) {\n    for (const el of payload.data) {\n      if (typeof el?.text === \"string\" && el.text.trim()) {\n        textChunks.push(el.text.trim());\n      }\n    }\n  }\n}\n\nconst fullText = textChunks.join(\"\\n\").trim();\n\n// Keep URL only if it is present in the incoming items.\nconst urlItem = inputItems.find((i) => typeof i.json?.url === \"string\" && i.json.url);\nconst url = urlItem ? urlItem.json.url : null;\n\nreturn [{\n  json: {\n    fullText,\n    url,\n  },\n}];\n"
      },
