    {
      "parameters": {
        "jsCode": "const allData = items[0].json; // รับค่า Array จาก OCR Node\nconst results = [];\n\n// เข้าถึงเนื้อหา Text จาก OCR ในจุด choices[0].message.content\nconst content = allData.results[0].message.choices[0].message.content;\n\n// ฟังก์ชันสำหรับดึงข้อมูลด้วย Regex\nconst extract = (regex, text, defaultValue = \"\") => {\n  const match = text.match(regex);\n  return match ? match[1].trim() : defaultValue;\n};\n\n// 1. ดึงชื่อ-นามสกุล\nconst insured_name = extract(/ชื่อ-นามสกุลผู้เอาประกันภัย\\s+(.+?)(?=\\s+อายุ|$)/, content);\n\n// 2. ดึงอายุ (แปลงเป็น Number)\nconst insured_age = parseInt(extract(/อายุ\\s+(\\d+)/, content)) || 0;\n\n// 3. ดึงเลขบัตรประชาชน (13 หลัก)\nconst id_card = extract(/เลขประจำตัวประชาชน\\s+(\\d{13})/, content);\n\n// 4. ดึงวันที่เสียชีวิต\nconst death_date = extract(/วันที่มรณกรรม\\s+([\\d/]+)/, content);\n\n// 5. ตรวจสอบว่าเป็นอุบัติเหตุหรือไม่ (เช็คจากเครื่องหมาย ✓ หรือเนื้อหา)\nconst is_accident = content.includes(\"✓อุบัติเหตุ\") || content.includes(\"มรณกรรมผิดธรรมชาติ\");\n\n// 6. ดึงรายละเอียดสาเหตุ (กรณีอุบัติเหตุ)\nconst accident_cause = extract(/สาเหตุจาก\\s+(.+?)(?=\\s+สถานที่|$)/, content);\n\n// 7. ดึงสาขาที่รับเรื่อง (เช็คจาก ณ บริษัท... สาขา ...)\nconst branch = extract(/สำนักงานใหญ่\\/สาขา\\s+(.+?)(?=\\n|$)/, content);\n\nresults.push({\n  json: {\n    insured_name,\n    insured_age,\n    id_card,\n    death_date,\n    is_accident,\n    accident_cause,\n    branch\n  }\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
